            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "transactionId",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the transaction."
              }
            ]
          },
          "docs": "Retrieves verification results for a given transaction. Returns a match result for each attribute compared."
        }
      ]
    }
  ],
  "bundled": true
